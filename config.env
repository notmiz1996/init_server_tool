# ============================================================
# init_server_tool 统一配置
# 所有脚本都会在本目录找到 config.env 时自动加载（set -a）
# 改参数请只改这里，不用改各脚本
# ============================================================

# ---------- 网络（init-server.sh） ----------
STATIC_IP=192.168.11.251
PREFIX_LEN=24
GATEWAY=192.168.11.1
DNS1=223.5.5.5
DNS2=114.114.114.114
# apt 镜像：tuna=清华（国内推荐）| official=不替换源（海外机器）
MIRROR=tuna
# 是否启用 UFW 防火墙：1/0。启用后放行：22/tcp、局域网段→8000、11010:11012
UFW_ENABLE=1

# ---------- GPU（install-nvidia.sh） ----------
NVIDIA_DRIVER=nvidia-driver-610
TARGET_VERSION=610.57.04
POWER_LIMIT_RATIO=80
# 期望识别的物理 GPU 数量，装完驱动后校验（0=跳过数量校验）
GPU_COUNT_EXPECT=4

# ---------- vLLM 推理服务（start-vllm.sh） ----------
VLLM_BIND_IP=192.168.11.251
VLLM_PORT=8000
VLLM_DOCKER_IMAGE=vllm-turing
VLLM_MODEL=Qwen/Qwen3.8-27B-FP8
# 张量并行度：留空 = 按 nvidia-smi 识别到的 GPU 数量自动决定
VLLM_TP_SIZE=
VLLM_WORKDIR=/home/notmiz/AI/javier-house/vllm-Turing
MODEL_CACHE=/home/notmiz/AI/model-cache
VLLM_CACHE_ROOT=/home/notmiz/AI/javier-house/vllm-Turing-cache/cache

# ---------- 机密（全部服务的密钥集中存放处，自动创建，600 权限） ----------
# vllm_api_key / easytier_secret 首次运行自动生成随机值；
# 若需与已存在的对端/客户端对齐，运行前把真实值写入对应文件即可
SECRET_DIR=/opt/secrets

# ---------- Python 工具（install-python-tools.sh） ----------
# 宿主机 modelscope 模型缓存目录（与容器挂载共用时设为同一目录，留空=不处理）
MODELSCOPE_CACHE=/home/notmiz/AI/model-cache

# ---------- 验证（verify.sh） ----------
# 是否做 docker GPU 冒烟测试（首跑会拉镜像，离线机可设 0）
VERIFY_DOCKER_SMOKE=1
